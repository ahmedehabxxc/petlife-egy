<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>Frontend\petlife-connect-45-main\</SpaRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Supabase" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="$(SpaRoot)node_modules\**" />
    <None Remove="$(SpaRoot)node_modules\**" />
  </ItemGroup>

  <Target Name="PublishFrontend" AfterTargets="ComputeFilesToPublish">
    <Message Importance="high" Text="Building frontend from $(SpaRoot)" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />

    <ItemGroup>
      <FrontendDist Include="$(SpaRoot)dist\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(FrontendDist)" DestinationFiles="@(FrontendDist->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
